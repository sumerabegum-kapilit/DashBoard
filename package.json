{
  "name": "scrumban-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Dashboard studio: one query engine for any data source (dummy data, CSV/JSON uploads, PostgreSQL), with a fully editable d3 dashboard.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:legacy": "node --test tests/legacy.api.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "d3": "7.9.0",
    "express": "4.21.2",
    "pg": "8.13.1"
  }
}
