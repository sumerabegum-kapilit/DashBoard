# Copy this file to .env and adjust.

# Port the dashboard runs on: http://localhost:3000
PORT=3000

# The earlier ScrumBan pages only: set LEGACY_SCRUMBAN=1 to serve them. The studio itself needs no database.
LEGACY_SCRUMBAN=
# Database the ScrumBan pages read. Every connection is read-only.
DATABASE_URL=postgres://scrum:scrum123@localhost:5432/scrum

# Dates, weekdays and hours are counted in this time zone.
APP_TIMEZONE=Asia/Kolkata

# Time entries longer than this many minutes are treated as entry errors and left out of hour totals.
MAX_ENTRY_MINUTES=720

# Leave empty to use today's date. Set a date (YYYY-MM-DD) to look at the data as of that day.
AS_OF=

# Where saved dashboards are kept (never in a database). Added sources and field edits go in the same folder.
STATE_FILE=storage/state.json

# Largest file that can be uploaded, in MB. Uploads are streamed to disk and stored in SQLite, so size does not need memory.
MAX_UPLOAD_MB=2048
